{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valle-design:dwg-validation:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "fixtureId",
    "fixtureSha256",
    "direction",
    "oracleId",
    "result",
    "evidenceObjectId",
    "validator",
    "observedAt",
    "reviewer",
    "reviewedAt"
  ],
  "properties": {
    "$schema": { "const": "urn:valle-design:dwg-validation:1.0.0" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "fixtureId": { "$ref": "#/$defs/id" },
    "fixtureSha256": { "$ref": "#/$defs/sha256" },
    "direction": { "enum": ["read", "write"] },
    "oracleId": { "$ref": "#/$defs/id" },
    "result": { "const": "accepted" },
    "evidenceObjectId": { "$ref": "#/$defs/id" },
    "validator": { "$ref": "#/$defs/tool" },
    "observedAt": { "type": "string", "format": "date-time" },
    "reviewer": { "$ref": "#/$defs/reviewer" },
    "reviewedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewer": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationId",
        "organizationId",
        "tool",
        "version",
        "authorizationObjectId"
      ],
      "properties": {
        "implementationId": { "$ref": "#/$defs/id" },
        "organizationId": { "$ref": "#/$defs/id" },
        "tool": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authorizationObjectId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
