{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valle.design/schemas/dwg-conformance-index-2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "updatedAt", "admission", "bundles"],
  "properties": {
    "$schema": { "const": "./index.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "updatedAt": { "type": "string", "format": "date" },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ownerReviewer", "secondReviewers", "factSnapshots"],
      "properties": {
        "ownerReviewer": { "const": "@Sergiovalle3121" },
        "secondReviewers": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reviewer" }
        },
        "factSnapshots": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/factSnapshot" }
        }
      }
    },
    "bundles": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bundle" }
    }
  },
  "$defs": {
    "reviewer": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "factSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "sourcePath",
        "objectPath",
        "sha256",
        "byteLength"
      ],
      "properties": {
        "repository": { "const": "Sergiovalle3121/valle-design" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourcePath": { "const": "packages/dwg-codec/FACT_REGISTER.json" },
        "objectPath": {
          "type": "string",
          "pattern": "^fact-snapshots/sha256/[a-f0-9]{64}$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 2097152 }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "manifestPath", "manifestSha256", "manifestByteLength"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^bundle-[a-z0-9][a-z0-9.-]{2,95}$"
        },
        "manifestPath": {
          "type": "string",
          "pattern": "^bundles/bundle-[a-z0-9][a-z0-9.-]{2,95}/manifest\\.json$"
        },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "manifestByteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    }
  }
}
