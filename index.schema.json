{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valle.design/schemas/dwg-conformance-index-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "bundles"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "updatedAt": { "type": "string", "format": "date" },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifestPath", "manifestSha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
          "manifestPath": {
            "type": "string",
            "pattern": "^bundles/[a-z0-9][a-z0-9.-]{0,127}/manifest\\.json$"
          },
          "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
