{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valle.design/schemas/dwg-conformance-bundle-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "dwgVersion",
    "rights",
    "sourceFactIds",
    "fixtures",
    "oracles",
    "validations",
    "reviews"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "status": { "const": "allowed" },
    "dwgVersion": {
      "enum": [
        "AC1009",
        "AC1012",
        "AC1014",
        "AC1015",
        "AC1018",
        "AC1021",
        "AC1024",
        "AC1027",
        "AC1032"
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "owner",
        "tool",
        "toolVersion",
        "outputRights",
        "redistribution",
        "attestationRef",
        "containsClientData"
      ],
      "properties": {
        "origin": {
          "enum": [
            "sergio-original",
            "donated-original",
            "licensed-third-party"
          ]
        },
        "owner": { "type": "string", "minLength": 1, "maxLength": 256 },
        "tool": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toolVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "outputRights": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "redistribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "attestationRef": {
          "type": "string",
          "pattern": "^private-attestation:[A-Za-z0-9._:-]{1,128}$"
        },
        "containsClientData": { "const": false }
      }
    },
    "sourceFactIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,127}$" }
    },
    "fixtures": { "$ref": "#/$defs/artifacts" },
    "oracles": { "$ref": "#/$defs/artifacts" },
    "validations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["validator", "version", "result", "evidenceSha256"],
        "properties": {
          "validator": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "result": { "enum": ["accepted", "rejected"] },
          "evidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^@[A-Za-z0-9-]{1,39}$" }
    }
  },
  "$defs": {
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "byteLength"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
          "path": {
            "type": "string",
            "pattern": "^(fixtures|oracles)/[A-Za-z0-9._/-]+$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byteLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 536870912
          }
        }
      }
    }
  }
}
