{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valle.design/schemas/dwg-conformance-bundle-2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "createdAt",
    "status",
    "dwgVersion",
    "factSnapshotSha256",
    "sourceFactIds",
    "objects",
    "fixtures",
    "reviews"
  ],
  "properties": {
    "$schema": { "const": "../../manifest.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^bundle-[a-z0-9][a-z0-9.-]{2,95}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "const": "allowed" },
    "dwgVersion": { "$ref": "#/$defs/version" },
    "factSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "sourceFactIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/factId" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/object" }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/review" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "factId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._:-]{2,127}$" },
    "reviewer": {
      "type": "string",
      "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version": {
      "enum": [
        "AC1009",
        "AC1012",
        "AC1014",
        "AC1015",
        "AC1018",
        "AC1021",
        "AC1024",
        "AC1027",
        "AC1032"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "role", "decision", "reviewedAt"],
      "properties": {
        "reviewer": { "$ref": "#/$defs/reviewer" },
        "role": { "enum": ["owner", "second-reviewer"] },
        "decision": { "const": "approved" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "byteLength", "mediaType"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "attestation",
            "evidence",
            "fixture",
            "ground-truth",
            "intake",
            "oracle",
            "validation"
          ]
        },
        "path": { "type": "string", "pattern": "^objects/sha256/[a-f0-9]{64}$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "mediaType": {
          "enum": [
            "application/json",
            "application/octet-stream",
            "application/pdf",
            "application/vnd.valle.dwg"
          ]
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objectId",
        "intakeObjectId",
        "oracleObjectIds",
        "validationObjectIds",
        "directions",
        "declaredVersion"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "objectId": { "$ref": "#/$defs/id" },
        "intakeObjectId": { "$ref": "#/$defs/id" },
        "oracleObjectIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "validationObjectIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "directions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["read", "write"] }
        },
        "declaredVersion": { "$ref": "#/$defs/version" }
      }
    }
  }
}
